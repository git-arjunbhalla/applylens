# Production values for AWS EC2 Docker Compose.
# Copy to a gitignored .env ON THE EC2 HOST only. Never commit the filled file.
# These placeholders are not credentials.

POSTGRES_USER=applylens
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=applylens

# At least 32 characters. Do not reuse the local development default.
JWT_SECRET=replace-with-at-least-32-random-characters

# Backend-only Gemini key. Leave empty to run the app without live AI.
# Never put this value in a VITE_* variable or the frontend image.
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash

# Public URL the browser uses to reach FastAPI on this host (port 8000).
# Replace with the Elastic IP or public DNS. No secrets in this value.
VITE_API_BASE_URL=http://YOUR_EC2_PUBLIC_IP:8000

# Browser origin for the nginx frontend on port 80 (no :80 suffix).
# Must match how users open the site, including http vs https.
CORS_ORIGINS=http://YOUR_EC2_PUBLIC_IP
