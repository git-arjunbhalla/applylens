# Local Docker Compose only. Copy to .env in this directory.
# These are development defaults, not production credentials.
# Do not commit .env. Compose interpolates this file; it is not copied into images.

POSTGRES_USER=applylens
POSTGRES_PASSWORD=applylens
POSTGRES_DB=applylens

JWT_SECRET=dev-only-change-me-use-32-plus-bytes

# Backend-only Gemini key. Leave empty unless you need live AI calls.
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash

# Browser URL for FastAPI (baked into the frontend image at build time).
VITE_API_BASE_URL=http://localhost:8000

# Allowed browser origins for the host-mapped frontend container.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
