APP_NAME=ApplyLens
ENVIRONMENT=development
DEBUG=true

# Async SQLAlchemy connection string for PostgreSQL.
# Replace credentials and host with your local or Neon values.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/applylens

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# JWT signing secret. Replace this with a long random value before any real use.
JWT_SECRET=replace-with-a-long-random-string-32-bytes-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend-only AI provider. Never put this key in frontend or VITE_* variables.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=30
